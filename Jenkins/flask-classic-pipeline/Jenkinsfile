pipeline {

    agent any

    environment {
        APP_DIR = 'jenkins/flask-classic-pipeline'
        VENV = 'venv'
    }

    stages {

        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    python3 -m venv ${VENV}

                    . ${VENV}/bin/activate

                    pip install --upgrade pip
                    pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    . ${VENV}/bin/activate

                    pytest
                    '''
                }
            }
        }

        stage('Code Analysis') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    . ${VENV}/bin/activate

                    pylint app.py || true  
                    '''
                }
            }
        }

        stage('Security Scan') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    . ${VENV}/bin/activate

                    bandit -r . || true
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    pkill -f app.py || true

                    nohup ${VENV}/bin/python app.py > output.log 2>&1 &
                    '''
                }
            }
        }
    }

    post {

        always {
            echo 'Pipeline execution completed.'
        }

        success {
            echo 'Application deployed successfully.'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}